{
  "name": "@daowolf/system-design-quest",
  "version": "1.3.1",
  "description": "Practise system design interviews as a game: trade-off duels, diagrams, estimates and whole-product quests.",
  "keywords": [
    "system-design",
    "interview",
    "practice",
    "game",
    "web-component",
    "custom-element"
  ],
  "license": "(MIT AND CC-BY-4.0)",
  "homepage": "https://github.com/dao-wolf/system-design-quest#readme",
  "bugs": "https://github.com/dao-wolf/system-design-quest/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dao-wolf/system-design-quest.git"
  },
  "type": "module",
  "sideEffects": true,
  "exports": {
    ".": "./dist/element.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/element.js",
    "dist/element.js.map",
    "dist/style.css",
    "dist/chapters.json",
    "content/LICENSE.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm build && python3 tools/serve.py --dir dist --port 4181",
    "gate": "python3 tools/check_content.py content",
    "build": "node tools/build.mjs",
    "test": "node --test tests/*.test.mjs && python3 -m unittest discover -s tests -p 'test_*.py'",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test",
    "check": "pnpm gate && pnpm lint && pnpm format:check && pnpm test && pnpm build && pnpm e2e",
    "docs": "vale README.md CONTRIBUTING.md SECURITY.md CONTENT.md",
    "mutate": "stryker run",
    "mutate:full": "stryker run --force"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@stryker-mutator/core": "^10.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
